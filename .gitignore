# Publish only project sources and explicitly prepared distribution files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/DEVELOPMENT.md
!/TEST-PLAN.ru.md
!/through-the-breach/
!/tests/
!/tools/
!/dist/
**/__pycache__/
**/*.pyc
**/node_modules/
**/.env*
**/*.pdf
**/*.log
!through-the-breach/packs/**/*.log
through-the-breach/packs/**/LOCK
through-the-breach/packs/**/LOG
through-the-breach/packs/**/LOG.old
**/.DS_Store
**/Thumbs.db
