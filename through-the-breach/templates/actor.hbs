<div class="ttb-layout">
  <header class="ttb-masthead"><img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="Портрет"><div><div class="ttb-eyebrow">THROUGH THE BREACH · СКВОЗЬ ПРОЛОМ</div><input class="ttb-name" name="name" value="{{actor.name}}" aria-label="Имя персонажа"><div class="ttb-subtitle">{{#if isNPC}}Персонаж Мастера Судьбы{{else}}Сужденный · личное досье{{/if}}</div></div><button type="button" data-action="table" class="ttb-table-button">Стол Судьбы</button></header>
  {{#if editable}}<div class="ttb-checks">{{#unless isNPC}}<button type="button" data-action="creation">Создание по Таро</button>{{/unless}}<button type="button" data-action="catalog">Добавить из библиотеки / купить</button></div>{{/if}}
  <nav class="ttb-tabs">{{#each tabs}}<button type="button" data-action="sheetTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
  <div class="ttb-body">
  {{#unless masterOnline}}<p class="ttb-alert">Мастер не подключён. Лист можно редактировать; карточные действия ждут подключения мастера.</p>{{/unless}}
  {{#if main}}
    <div class="ttb-section-head"><h2>Аспекты</h2><span>Нажмите название для проверки</span></div>
    <div class="ttb-aspects">{{#each aspects}}<label><button type="button" data-action="check" data-skill="{{key}}">{{label}}</button><input name="system.aspects.{{key}}" type="number" value="{{value}}" min="-5" max="10"><small>Временная поправка</small><input name="system.temporaryAspects.{{key}}" type="number" value="{{temporary}}"><small>Итог: {{total}}</small></label>{{/each}}</div>
    <h2>Состояние</h2><label class="ttb-check"><input type="checkbox" name="system.autoArmor" {{checked s.autoArmor}}>Рассчитывать броню по надетым предметам</label><p class="ttb-help">Итоговая броня: {{c.armor}}. Защита = 2 + максимум Скорости и ранга Уклонения + поправки − броня. Сила воли = 2 + максимум Упорства и ранга Концентрации + поправки.</p><div class="ttb-fields ttb-four"><label>Ранения: осталось<input name="system.wounds.value" type="number" value="{{s.wounds.value}}"><small>Максимум: {{c.wounds}}</small></label><label>Броня<input name="system.armor" type="number" value="{{s.armor}}" min="0" max="3"></label><label>Очки действий<input name="system.ap.value" type="number" value="{{s.ap.value}}" min="0"></label><label>Рост<input name="system.height" type="number" value="{{s.height}}" min="0"></label></div>
    <div class="ttb-derived">{{#each stats}}<div><span>{{label}}</span><strong>{{value}}</strong><label>Поправка<input type="number" name="system.bonuses.{{id}}" value="{{bonus}}"></label></div>{{/each}}</div>
    <div class="ttb-actions"><button type="button" data-action="check" data-skill="defense">Проверка защиты</button><button type="button" data-action="check" data-skill="willpower">Проверка силы воли</button><button type="button" data-action="check" data-kind="initiative">Инициатива</button><button type="button" data-action="check" data-kind="damage">Флип урона</button></div>
    {{#if isNPC}}<div class="ttb-npc"><label>Значение ранга<input name="system.rank" type="number" value="{{s.rank}}" min="0" max="20"></label><p>СЛ атаки против этого персонажа: <b>{{npcDefense}}</b> по Защите или <b>{{npcWillpower}}</b> по Силе воли. Для инициативы и обычных проверок используется ранг; для урона мастер тянет карты.</p></div>{{/if}}
    <label class="ttb-check"><input type="checkbox" name="system.unconscious" {{checked s.unconscious}}>Без сознания (восстановление отмечает мастер)</label><label class="ttb-check"><input type="checkbox" name="system.prone" {{checked s.prone}}>Сбит с ног</label>{{#if isGM}}<button type="button" data-action="tieOrder">Порядок при ничьей инициативы</button>{{/if}}<h2>Досье</h2><div class="ttb-fields"><label>Игрок<input name="system.player" value="{{s.player}}"></label><label>Стремление<input name="system.pursuit" value="{{s.pursuit}}"></label><label>Станция<input name="system.station" value="{{s.station}}"></label><label>Опыт<input name="system.xp" type="number" value="{{s.xp}}" min="0"></label><label>Скрипы<input name="system.scrip" type="number" step="0.01" value="{{s.scrip}}" min="0"></label><label>Характеристики<input name="system.characteristics" value="{{s.characteristics}}"></label></div>
    <label class="ttb-check"><input type="checkbox" name="system.walkRoundUp" {{checked s.walkRoundUp}}>Округлять половину Скорости вверх для Ходьбы</label>
    <h2>Ход и состояния</h2>{{#if turnPending}}<p class="ttb-alert">Обработка хода прервана. Мастер проверяет ОД и состояния.{{#if isGM}} <button type="button" data-action="turnAction" data-op="recoverTurn">Подтвердить последствия прерванного хода</button>{{/if}}</p>{{/if}}
    <div class="ttb-fields"><label>ОД в начале хода<input type="number" name="system.ap.max" value="{{s.ap.max}}" min="0" max="99"></label><label>Кровотечение<input type="number" name="system.bleeding" value="{{s.bleeding}}" min="0" max="99"></label></div>
    <label class="ttb-check"><input type="checkbox" name="system.living" {{checked s.living}}>Живой (кровотечение действует только на живых)</label>
    <label class="ttb-check"><input type="checkbox" name="system.openWoundFirst" {{checked s.openWoundFirst}}>Открытая рана срабатывает до обычного роста кровотечения</label><label class="ttb-check"><input type="checkbox" name="system.dead" {{checked s.dead}}>Погиб</label>
    {{#if isGM}}<button type="button" data-action="automation" data-op="heal">Применить исцеление</button>{{/if}}<div class="ttb-actions"><button type="button" data-action="turnAction" data-op="spendAP" data-cost="0">Выполнить действие (0)</button><button type="button" data-action="turnAction" data-op="spendAP" data-cost="1">Потратить 1 ОД</button><button type="button" data-action="turnAction" data-op="spendAP" data-cost="2">Потратить 2 ОД</button><button type="button" data-action="turnAction" data-op="hyperventilation">Пропуск: снять гипервентиляцию (1 ОД)</button>{{#if isGM}}<button type="button" data-action="turnAction" data-op="addEffect">Добавить состояние</button><button type="button" data-action="turnAction" data-op="endSceneEffects">Снять временные состояния после сцены</button>{{/if}}</div>
    <p class="ttb-help">Трекер боя восстанавливает ОД в начале хода и обрабатывает конец хода. Атака списывает стоимость оружия в активном бою. Для остальных действий используйте кнопки расхода ОД. При нескольких особых эффектах порядок разрешения согласует мастер.</p>
    {{#each effects}}<p>{{label}} · значение {{value}}{{#if timed}} · срок: ход № {{ends}}, фаза {{endPhase}}{{/if}}{{#if @root.isGM}} <button type="button" data-action="turnAction" data-op="clearEffect" data-effect-id="{{id}}">Снять</button>{{/if}}</p>{{/each}}
    <label>Журнал последствий (текст не управляет состояниями)<textarea name="system.conditions">{{s.conditions}}</textarea></label>
  {{/if}}
  {{#if skillsTab}}<p class="ttb-help">Ранг 0–5. СН = ранг + выбранный аспект. Масти: R ♥, C ♠, T ♣, M ♦. Для магии выберите подходящий аспект. Кнопка с названием навыка открывает проверку.</p><div class="ttb-skill-groups">{{#each skillGroups}}<section><h2>{{label}}</h2><div class="ttb-skill-row ttb-skill-header"><span>Навык</span><span>Ранг</span><span>Аспект</span><span>СН</span><span>Масти</span></div>{{#each skills}}<div class="ttb-skill-row"><button type="button" data-action="check" data-skill="{{id}}">{{label}}</button><input name="system.skills.{{id}}.rank" type="number" min="0" max="5" value="{{rank}}" aria-label="Ранг {{label}}"><select name="system.skills.{{id}}.aspect" aria-label="Аспект {{label}}">{{selectOptions @root.aspectOptions selected=aspect}}</select><strong>{{av}}</strong><input name="system.skills.{{id}}.suits" value="{{suits}}" aria-label="Масти {{label}}" placeholder="R"></div><input class="ttb-trigger" name="system.skills.{{id}}.trigger" value="{{trigger}}" placeholder="Триггеры {{label}} — текст и требуемые масти">{{/each}}</section>{{/each}}</div>{{/if}}
  {{#if s.operationPending}}<p class="ttb-alert">Прервана операция: {{s.operationPending}}. Проверьте ресурсы. {{#if isGM}}<button type="button" data-action="automation" data-op="recoverOperation">Последствия проверены</button>{{/if}}</p>{{/if}}
  {{#if recordsTab}}<h2>Записи персонажа</h2><div class="ttb-actions"><button type="button" data-action="createRecord" data-type="equipment">Добавить предмет</button><button type="button" data-action="createWeapon">Добавить оружие</button><button type="button" data-action="createRecord" data-type="talent">Добавить талант</button><button type="button" data-action="createRecord" data-type="talent" data-category="pursuit">Добавить Стремление</button><button type="button" data-action="createRecord" data-type="magic">Добавить магию</button></div>
  <p class="ttb-help">Откройте запись по названию и заполните параметры по книге. Активные поправки учитываются в листе и карточных проверках. Старые текстовые записи доступны во вкладке «История».</p>
  {{#each records}}<section class="ttb-record"><div class="ttb-section-head"><button type="button" data-action="item" data-item-id="{{id}}">{{name}}</button><span>{{#if equipped}}Доступно{{else}}Выключено{{/if}} · количество {{quantity}}</span></div><p>{{reference}}</p>{{#if bonusTarget}}<p>Поправка: {{bonusTarget}} · {{bonus}} · флипы {{flipBonus}} · масти {{bonusSuits}}</p>{{/if}}
  {{#if isWeapon}}<p>{{damage}} · {{range}} · атака {{apCost}} ОД{{#if capacity}} · заряжено {{loaded}}/{{capacity}} · запас {{reserve}} · перезарядка {{reloadProgress}}/{{reloadCost}} ОД{{/if}}</p><div class="ttb-actions"><button type="button" data-action="attack" data-item-id="{{id}}">Атаковать</button>{{#if capacity}}<button type="button" data-action="automation" data-op="reload" data-item-id="{{id}}">Перезарядить</button>{{/if}}</div>{{/if}}
  {{#if isMagic}}<p>СЛ {{tn}} {{required}} · {{apCost}} ОД · {{range}} · {{duration}}</p><button type="button" data-action="automation" data-op="castSpell" data-item-id="{{id}}">Применить магию</button>{{/if}}
  {{#if isGrimoire}}{{#if @root.isGM}}<button type="button" data-action="automation" data-op="attune" data-item-id="{{id}}">Настроиться на Гримуар</button>{{/if}}{{/if}}
  {{#if isEquipment}}<button type="button" data-action="automation" data-op="buyItem" data-item-id="{{id}}">Купить 1 ({{price}} скр.)</button>{{#if isConsumable}}<button type="button" data-action="automation" data-op="useItem" data-item-id="{{id}}">Использовать 1</button>{{/if}}{{/if}}
  <p class="ttb-help">{{description}}</p></section>{{else}}<p>Пока нет отдельных записей. Добавьте их кнопками выше.</p>{{/each}}{{/if}}
  {{#if developmentTab}}<h2>Развитие</h2><label>Текущее Стремление<select name="system.currentPursuitId">{{selectOptions pursuitOptions selected=s.currentPursuitId}}</select></label><p class="ttb-help">Способность и доступные навыки берутся из текущего Стремления, даже если в эпилоге продвигается другое продвинутое Стремление. Стартовый талант и талант шага 0 добавьте отдельно по книге.</p><p>Доступно опыта: <b>{{s.xp}}</b></p><div class="ttb-actions">{{#if isGM}}<button type="button" data-action="automation" data-op="epilogue">Открыть эпилог сессии</button>{{/if}}<button type="button" data-action="automation" data-op="learnTrigger">Изучить триггер (1 опыт)</button></div><p class="ttb-help">Мастер выбирает два навыка. Навыки способности продвигаемого Стремления добавляются из его записи. За сессию можно повысить один разрешённый навык; цена равна текущему рангу. Таланты за шаг и требования выбираются по таблице книги.</p>
  {{#each epilogues}}<section class="ttb-record"><b>{{id}}</b><p>Доступные навыки: {{eligibleNames}}</p>{{#if chosen}}<p>Повышен: {{chosenName}}</p>{{else}}{{#if closed}}<p>Эпилог закрыт без повышения</p>{{else}}<button type="button" data-action="automation" data-op="advanceSkill" data-epilogue-id="{{id}}">Выбрать повышение</button>{{/if}}{{/if}}</section>{{/each}}
  <h2>Шаги Стремлений</h2>{{#each pursuitRows}}<p>{{name}}: {{step}} / {{maximum}}</p>{{/each}}
  <h2>Изученные триггеры</h2>{{#each triggers}}<section class="ttb-record"><b>{{skillName}} · {{name}} · {{suits}}</b><p>{{description}}</p></section>{{else}}<p class="ttb-help">Ранее записанные триггеры сохранены во вкладке «Навыки» как текст. Они не перенесены автоматически, чтобы не назначить неверные масти.</p>{{/each}}{{/if}}
  {{#if fateTab}}
    {{#unless isNPC}}
    <div class="ttb-section-head"><h2>Рука контроля</h2><span>{{handCount}} / 5 карт</span></div>
    {{#if overflow}}<p class="ttb-alert">Выберите лишние карты и сбросьте их до пяти. Затем можно продолжить проверки.</p>{{/if}}
    {{#unless hasDeck}}<p class="ttb-help">Выберите четыре разные масти ниже. Затем мастер создаёт личную колоду кнопкой «Подготовить колоду». После создания состав зафиксирован.</p>{{/unless}}
    <div class="ttb-hand">{{#each handCards}}<label class="ttb-hand-card"><img src="{{img}}" alt="{{name}}"><span><input type="checkbox" data-hand-card="{{id}}">{{name}}</span></label>{{else}}<p class="ttb-help">В руке пока нет карт. Мастер раздаёт три карты в конце пролога.</p>{{/each}}</div>
    <div class="ttb-actions"><button type="button" data-action="hand" data-op="discard">Сбросить выбранные</button>{{#if credits}}<button type="button" data-action="hand" data-op="credit">Взять за перетасовку ({{credits}})</button><button type="button" data-action="hand" data-op="declineCredit">Отказаться от добора</button>{{/if}}{{#if refresh}}<button type="button" data-action="hand" data-op="refresh">Обновить руку после сцены</button>{{/if}}{{#if isGM}}{{#unless hasDeck}}<button type="button" data-action="hand" data-op="setupActor">Подготовить колоду</button>{{/unless}}{{#if hasDeck}}<button type="button" data-action="hand" data-op="give">Выдать 1 карту</button>{{/if}}{{/if}}</div>
    <p class="ttb-help">Чтобы Обмануть судьбу, нажмите соответствующую кнопку в сообщении проверки. Добор за талант подтверждает мастер кнопкой «Выдать 1 карту».</p>
    <h2>Смешанная колода</h2><div class="ttb-fields">{{#each twistRoles}}<label>{{label}}<select name="system.twist.{{index}}" {{#if @root.hasDeck}}disabled{{/if}}>{{selectOptions @root.suitOptions selected=suit}}</select></label>{{/each}}</div><p class="ttb-help">Определяющая: 1, 5, 9, 13 · Предков: 4, 8, 12 · Центральная: 3, 7, 11 · Наследия: 2, 6, 10.</p>
    {{else}}<p class="ttb-help">У персонажей мастера нет личной руки и Обмана судьбы. Мастер управляет общей колодой через «Стол Судьбы».</p>{{/unless}}
    {{#if openChecks}}<p class="ttb-alert">В чате есть незавершённая проверка. Выберите карту, при желании обманите судьбу и нажмите «Завершить».</p>{{/if}}
    <h2>Предсказание судьбы</h2><textarea name="system.fate" class="ttb-long" placeholder="Корень, тело, разум, станция и стремление; карты Таро и пророчество">{{s.fate}}</textarea>
  {{/if}}
  {{#if storyTab}}<h2>Оружие и снаряжение</h2><button type="button" data-action="createWeapon">Добавить оружие</button>{{#each weapons}}<p><button type="button" data-action="attack" data-item-id="{{id}}">Атака: {{name}}</button> · {{skill}} · {{range}} · {{damage}}</p>{{/each}}<textarea class="ttb-long" name="system.gear" placeholder="Название, навык, дальность, урон слабый/умеренный/тяжёлый, боезапас и свойства">{{s.gear}}</textarea><h2>Таланты и способности Стремления</h2><textarea class="ttb-long" name="system.talents">{{s.talents}}</textarea><div class="ttb-fields"><label>Магическая теория<input name="system.magicTheory" value="{{s.magicTheory}}"></label><label>Гримуары, Магия и Иммуто<textarea name="system.grimoire">{{s.grimoire}}</textarea></label></div><h2>Предметы Foundry</h2>{{#each items}}<p><button type="button" data-action="item" data-item-id="{{id}}">{{name}}</button> × {{quantity}} · {{description}}</p>{{else}}<p class="ttb-help">Можно перетащить предметы из вкладки «Предметы» Foundry в этот лист.</p>{{/each}}<h2>История и заметки</h2><textarea class="ttb-long" name="system.notes">{{s.notes}}</textarea>{{/if}}
  </div><footer class="ttb-footer">Изменения сохраняются автоматически · Правила второго издания · {{systemVersion}}</footer>
</div>
