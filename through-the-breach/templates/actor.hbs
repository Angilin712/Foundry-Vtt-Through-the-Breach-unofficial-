<div class="ttb-layout">
  <header class="ttb-masthead"><img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{ttbText 'Портрет'}}"><div><div class="ttb-eyebrow">{{ttbText 'THROUGH THE BREACH · СКВОЗЬ ПРОЛОМ'}}</div><input class="ttb-name" name="name" value="{{actor.name}}" aria-label="{{ttbText 'Имя персонажа'}}"><div class="ttb-subtitle">{{#if isNPC}}{{ttbText 'Персонаж Мастера Судьбы'}}{{else}}{{ttbText 'Сужденный · личное досье'}}{{/if}}</div></div><button type="button" data-action="table" class="ttb-table-button">{{ttbText 'Стол Судьбы'}}</button></header>
  {{#if editable}}<div class="ttb-checks">{{#unless isNPC}}{{#unless creationComplete}}<button type="button" data-action="creation">{{ttbText 'Создание по Таро'}}</button>{{/unless}}{{/unless}}<button type="button" data-action="catalog">{{ttbText 'Добавить из библиотеки / купить'}}</button></div>{{/if}}
  <nav class="ttb-tabs" aria-label="{{ttbText 'Разделы листа'}}">{{#each tabs}}<button type="button" data-action="sheetTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}"><img src="{{icon}}" alt="" aria-hidden="true"><span>{{label}}</span></button>{{/each}}</nav>
  <div class="ttb-body">
  {{#if bestiary}}<p class="ttb-help ttb-bestiary-reference">{{bestiary.reference}} {{ttbText '· Особые способности и триггеры разрешает мастер по описанию.'}}</p>{{/if}}
  {{#if isNPC}}{{#if main}}<div class="ttb-npc-token"><img src="{{tokenImg}}" alt="{{ttbText 'Токен персонажа'}}"><button type="button" data-action="configureToken">{{ttbText 'Настроить токен'}}</button><small>{{ttbText 'Каждая копия на сцене имеет отдельное состояние.'}}</small></div>{{/if}}{{/if}}
  {{#if isNPC}}{{#if main}}<label class="ttb-check"><input name="system.canCharge" type="checkbox" {{checked s.canCharge}}>{{ttbText 'Может совершать Рывок'}}</label>{{/if}}{{/if}}
  {{#unless masterOnline}}<p class="ttb-alert">{{ttbText 'Мастер не подключён. Лист можно редактировать; карточные действия ждут подключения мастера.'}}</p>{{/unless}}
  {{#if main}}
    <div class="ttb-section-head"><h2>{{ttbText 'Аспекты'}}</h2><span>{{ttbText 'Нажмите название для проверки'}}</span></div>
    <div class="ttb-aspects">{{#each aspects}}<label><button type="button" data-action="check" data-skill="{{key}}" aria-label="{{ttbText 'Проверка аспекта'}} {{label}}">{{label}}</button><input name="system.aspects.{{key}}" type="number" value="{{value}}" min="-5" max="10" aria-label="{{ttbText 'Аспект'}} {{label}}"><small>{{ttbText 'Итог:'}} <b>{{total}}</b></small></label>{{/each}}</div>
    <div class="ttb-section-head"><h2>{{ttbText 'Состояние'}}</h2><span>{{ttbText 'Броня:'}} {{c.armor}}</span></div>
    <div class="ttb-fields ttb-four ttb-vitals">{{#if s.rankWounds}}<label>{{ttbText 'Ранг роя'}}<input name="system.rank" type="number" value="{{s.rank}}" min="0" max="20"><small>{{ttbText 'Вместо ранений; при 0 рой распадается'}}</small></label>{{else}}<label>{{ttbText 'Ранения'}}<input name="system.wounds.value" type="number" value="{{s.wounds.value}}"><small>{{ttbText 'из'}} {{c.wounds}}</small></label>{{/if}}<label>{{ttbText 'Броня'}}<input name="system.armor" type="number" value="{{s.armor}}" min="0" max="3"></label><label>{{ttbText 'Очки действий'}}<input name="system.ap.value" type="number" value="{{s.ap.value}}" min="0"></label><label>{{ttbText 'Рост'}}<input name="system.height" type="number" value="{{s.height}}" min="0"></label></div>
    <div class="ttb-derived">{{#each stats}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</div>
    <div class="ttb-actions ttb-primary-actions"><button type="button" data-action="check" data-skill="defense">{{ttbText 'Проверка защиты'}}</button><button type="button" data-action="check" data-skill="willpower">{{ttbText 'Проверка силы воли'}}</button><button type="button" data-action="check" data-kind="initiative">{{ttbText 'Инициатива'}}</button><button type="button" data-action="check" data-kind="damage">{{ttbText 'Флип урона'}}</button></div>
    <div class="ttb-actions ttb-ap-actions"><span>{{ttbText 'Расход ОД'}}</span><button type="button" data-action="turnAction" data-op="focusAction">{{ttbText 'Сосредоточиться (1 ОД)'}}</button><button type="button" data-action="turnAction" data-op="walkAction">{{movementMode}}</button><button type="button" data-action="turnAction" data-op="spendAP" data-cost="0">{{ttbText 'Выполнить действие (0)'}}</button><button type="button" data-action="turnAction" data-op="spendAP" data-cost="1">{{ttbText 'Потратить 1 ОД'}}</button><button type="button" data-action="turnAction" data-op="spendAP" data-cost="2">{{ttbText 'Потратить 2 ОД'}}</button></div>
    {{#if isNPC}}<div class="ttb-npc">{{#unless s.rankWounds}}<label>{{ttbText 'Значение ранга'}}<input name="system.rank" type="number" value="{{s.rank}}" min="0" max="20"></label>{{/unless}}<p>{{ttbText 'СЛ по Защите:'}} <b>{{npcDefense}}</b> {{ttbText '· по Силе воли:'}} <b>{{#if s.immuneWillpower}}{{ttbText 'невосприимчив'}}{{else}}{{npcWillpower}}{{/if}}</b>{{ttbText '. Для обычных проверок используется ранг, для урона — карты.'}}</p></div>{{/if}}
    <details class="ttb-fold" data-fold="conditions" {{#if hasStates}}open{{/if}}><summary>{{ttbText 'Ход и состояния'}}{{#if hasStates}}<span class="ttb-badge">{{ttbText 'Есть состояния'}}</span>{{/if}}</summary>
      <div class="ttb-check-grid"><label class="ttb-check"><input type="checkbox" name="system.unconscious" {{checked s.unconscious}}>{{ttbText 'Без сознания'}}</label><label class="ttb-check"><input type="checkbox" name="system.prone" {{checked s.prone}}>{{ttbText 'Сбит с ног'}}</label><label class="ttb-check"><input type="checkbox" name="system.dead" {{checked s.dead}}>{{ttbText 'Погиб'}}</label></div>
      {{#if turnPending}}<p class="ttb-alert">{{ttbText 'Обработка хода прервана. Мастер проверяет ОД и состояния.'}}{{#if isGM}} <button type="button" data-action="turnAction" data-op="recoverTurn">{{ttbText 'Подтвердить последствия прерванного хода'}}</button>{{/if}}</p>{{/if}}
      <div class="ttb-fields"><label>{{ttbText 'ОД в начале хода'}}<input type="number" name="system.ap.max" value="{{s.ap.max}}" min="0" max="99"></label><label>{{ttbText 'Кровотечение'}}<input type="number" name="system.bleeding" value="{{s.bleeding}}" min="0" max="99"></label></div>
      <label class="ttb-check"><input type="checkbox" name="system.living" {{checked s.living}}>{{ttbText 'Живой (кровотечение действует только на живых)'}}</label>
      <label class="ttb-check"><input type="checkbox" name="system.openWoundFirst" {{checked s.openWoundFirst}}>{{ttbText 'Открытая рана до обычного роста кровотечения'}}</label>
      <div class="ttb-actions"><button type="button" data-action="turnAction" data-op="hyperventilation">{{ttbText 'Пропуск: снять гипервентиляцию (1 ОД)'}}</button>{{#if isGM}}<button type="button" data-action="automation" data-op="heal">{{ttbText 'Применить исцеление'}}</button><button type="button" data-action="turnAction" data-op="addEffect">{{ttbText 'Добавить состояние'}}</button><button type="button" data-action="turnAction" data-op="endSceneEffects">{{ttbText 'Снять временные состояния после сцены'}}</button><button type="button" data-action="tieOrder">{{ttbText 'Порядок при ничьей инициативы'}}</button>{{/if}}</div>
      {{#each effects}}<div class="ttb-effect"><b>{{label}}</b><span>{{ttbText 'Значение'}} {{value}}{{#if timed}} {{ttbText '· ход'}} {{ends}}, {{endPhase}}{{/if}}</span>{{#if @root.isGM}}<button type="button" data-action="turnAction" data-op="clearEffect" data-effect-id="{{id}}">{{ttbText 'Снять'}}</button>{{/if}}</div>{{/each}}
      <label>{{ttbText 'Журнал последствий'}}<textarea name="system.conditions">{{s.conditions}}</textarea></label>
      <p class="ttb-help">{{ttbText 'Журнал — заметки. Состояния добавляются отдельными кнопками. Трекер боя восстанавливает ОД в начале хода; атака списывает стоимость оружия в активном бою.'}}</p>
    </details>
    <h2>{{ttbText 'Досье'}}</h2><div class="ttb-fields ttb-dossier"><label>{{ttbText 'Игрок'}}<input name="system.player" value="{{s.player}}"></label><label>{{ttbText 'Стремление'}}<input name="system.pursuit" value="{{s.pursuit}}"></label><label>{{ttbText 'Станция'}}<input name="system.station" value="{{s.station}}"></label><label>{{ttbText 'Опыт'}}<input name="system.xp" type="number" value="{{s.xp}}" min="0"></label><label>{{ttbText 'Скрипы'}}<input name="system.scrip" type="number" step="0.01" value="{{s.scrip}}" min="0"></label><label>{{ttbText 'Характеристики'}}<input name="system.characteristics" value="{{s.characteristics}}"></label></div>
    <details class="ttb-fold" data-fold="adjustments"><summary>{{ttbText 'Поправки и настройки расчётов'}}</summary>
      <h3>{{ttbText 'Временные поправки аспектов'}}</h3><div class="ttb-fields ttb-four">{{#each aspects}}<label>{{label}}<input name="system.temporaryAspects.{{key}}" type="number" value="{{temporary}}"></label>{{/each}}</div>
      <label>{{ttbText 'Владелец подчинённого конструкта'}}<select name="system.controllerUuid">{{selectOptions controllerOptions selected=s.controllerUuid}}</select></label><h3>{{ttbText 'Поправки показателей'}}</h3><div class="ttb-fields ttb-dossier">{{#each stats}}<label>{{label}}<input type="number" name="system.bonuses.{{id}}" value="{{bonus}}"></label>{{/each}}</div>
      <label class="ttb-check"><input type="checkbox" name="system.autoArmor" {{checked s.autoArmor}}>{{ttbText 'Рассчитывать броню по надетым предметам'}}</label><label class="ttb-check"><input type="checkbox" name="system.walkRoundUp" {{checked s.walkRoundUp}}>{{ttbText 'Округлять половину Скорости вверх для Ходьбы'}}</label>
      <p class="ttb-help">{{ttbText 'Защита = 2 + максимум Скорости и ранга Уклонения + поправки − броня. Сила воли = 2 + максимум Упорства и ранга Концентрации + поправки.'}}</p>
    </details>
  {{/if}}
  {{#if skillsTab}}
    <div class="ttb-skill-tools"><input type="search" data-skill-search placeholder="{{ttbText 'Найти навык…'}}" aria-label="{{ttbText 'Найти навык'}}"><label class="ttb-check"><input type="checkbox" data-trained-only>{{ttbText 'Только изученные'}}</label></div>
    <p class="ttb-help">{{ttbText 'Нажмите название для проверки. СН = ранг + аспект. R — Бараны, C — Вороны, T — Томы, M — Маски.'}}</p>
    <div class="ttb-skill-groups">{{#each skillGroups}}<details class="ttb-fold ttb-skill-group" data-fold="skills-{{id}}" data-skill-group open><summary>{{label}}<span class="ttb-badge">{{skills.length}}</span></summary><div class="ttb-skill-row ttb-skill-header"><span>{{ttbText 'Навык'}}</span><span>{{ttbText 'Ранг'}}</span><span>{{ttbText 'Аспект'}}</span><span>{{ttbText 'СН'}}</span><span>{{ttbText 'Масти'}}</span><span></span></div>
    {{#each skills}}<div class="ttb-skill-entry" data-skill-entry data-label="{{label}}"><div class="ttb-skill-row"><span class="ttb-skill-label"><button type="button" data-action="check" data-skill="{{id}}" aria-describedby="skill-help-{{@root.actor.id}}-{{id}}">{{label}}</button><span class="ttb-skill-tip" id="skill-help-{{@root.actor.id}}-{{id}}" role="tooltip"><b>{{label}}</b><span>{{help}}</span><small>{{aspectName}} {{ttbText '· Основная книга, стр.'}} {{page}}</small></span></span><input name="system.skills.{{id}}.rank" type="number" min="0" max="5" value="{{rank}}" aria-label="{{ttbText 'Ранг'}} {{label}}"><select name="system.skills.{{id}}.aspect" aria-label="{{ttbText 'Аспект'}} {{label}}">{{selectOptions @root.aspectOptions selected=aspect}}</select><strong>{{av}}</strong><input name="system.skills.{{id}}.suits" value="{{suits}}" aria-label="{{ttbText 'Масти'}} {{label}}" placeholder="—"><button class="ttb-skill-send" type="button" data-action="skillInfo" data-skill="{{id}}" aria-label="{{ttbText 'Описание навыка'}} {{label}} {{ttbText 'в чат'}}" title="{{ttbText 'Отправить описание в чат'}}"><img src="systems/through-the-breach/assets/ui/send.svg" alt="" aria-hidden="true"></button></div><details class="ttb-skill-note" data-fold="note-{{id}}"><summary>{{ttbText 'Заметка о триггерах'}}{{#if trigger}} {{ttbText '· заполнена'}}{{/if}}</summary><input class="ttb-trigger" name="system.skills.{{id}}.trigger" value="{{trigger}}" aria-label="{{ttbText 'Триггеры'}} {{label}}" placeholder="{{ttbText 'Текст и требуемые масти'}}"></details></div>{{/each}}</details>{{/each}}</div>
    <p class="ttb-help" data-skill-empty hidden>{{ttbText 'Подходящих навыков нет. Измените поиск или снимите фильтр.'}}</p>
  {{/if}}
  {{#if s.operationPending}}<p class="ttb-alert">{{ttbText 'Прервана операция:'}} {{s.operationPending}}{{ttbText '. Проверьте ресурсы.'}} {{#if isGM}}<button type="button" data-action="automation" data-op="recoverOperation">{{ttbText 'Последствия проверены'}}</button>{{/if}}</p>{{/if}}
  {{#if recordsTab}}<h2>{{ttbText 'Записи персонажа'}}</h2><div class="ttb-actions"><button type="button" data-action="createRecord" data-type="equipment">{{ttbText 'Добавить предмет'}}</button><button type="button" data-action="createWeapon">{{ttbText 'Добавить оружие'}}</button><button type="button" data-action="createRecord" data-type="talent">{{ttbText 'Добавить талант'}}</button><button type="button" data-action="createRecord" data-type="talent" data-category="pursuit">{{ttbText 'Добавить Стремление'}}</button><button type="button" data-action="createRecord" data-type="magic">{{ttbText 'Добавить магию'}}</button><button type="button" data-action="spellBuilder">{{ttbText 'Создать заклинание'}}</button></div>
  <p class="ttb-help">{{ttbText 'Откройте запись по названию и заполните параметры по книге. Активные поправки учитываются в листе и карточных проверках. Старые текстовые записи доступны во вкладке «История».'}}</p>
  {{#each records}}<section class="ttb-record" data-record-id="{{id}}"><div class="ttb-section-head"><button type="button" class="ttb-record-name" data-action="item" data-item-id="{{id}}"><img src="{{img}}" alt="">{{name}}</button>{{#if @root.editable}}<button class="ttb-record-delete" type="button" data-action="deleteRecord" data-item-id="{{id}}" aria-label="{{ttbText 'Удалить'}} {{name}}" title="{{ttbText 'Удалить запись'}}">×</button>{{/if}}<span>{{#if equipped}}{{ttbText 'Доступно'}}{{else}}{{ttbText 'Выключено'}}{{/if}} {{ttbText '· количество'}} {{quantity}}</span></div><p>{{reference}}</p>{{#if bonusTarget}}<p>{{ttbText 'Поправка:'}} {{bonusTarget}} · {{bonus}} {{ttbText '· флипы'}} {{flipBonus}} {{ttbText '· масти'}} {{bonusSuits}}</p>{{/if}}
  {{#if isWeapon}}<p>{{rating}}</p><p>{{damage}} · {{range}} {{ttbText '· атака'}} {{apCost}} {{ttbText 'ОД'}}{{#if capacity}} {{ttbText '· заряжено'}} {{loaded}}/{{capacity}} {{ttbText '· запас'}} {{reserve}} {{ttbText '· перезарядка'}} {{reloadProgress}}/{{reloadCost}} {{ttbText 'ОД'}}{{/if}}</p><div class="ttb-actions"><button type="button" data-action="attack" data-item-id="{{id}}">{{ttbText 'Атаковать'}}</button>{{#if capacity}}<button type="button" data-action="automation" data-op="reload" data-item-id="{{id}}">{{ttbText 'Перезарядить'}}</button>{{/if}}</div>{{/if}}
  {{#if isMagic}}<p>{{ttbText 'СЛ'}} {{tn}} {{required}} · {{apCost}} {{ttbText 'ОД ·'}} {{range}} · {{duration}}</p><button type="button" data-action="automation" data-op="castSpell" data-item-id="{{id}}">{{ttbText 'Применить магию'}}</button>{{/if}}
  {{#if isGrimoire}}{{#if @root.isGM}}<button type="button" data-action="automation" data-op="attune" data-item-id="{{id}}">{{ttbText 'Настроиться на Гримуар'}}</button>{{/if}}{{/if}}
  {{#if isEquipment}}<button type="button" data-action="automation" data-op="buyItem" data-item-id="{{id}}">{{ttbText 'Купить 1 ('}}{{price}} {{ttbText 'скр.)'}}</button>{{#if isConsumable}}<button type="button" data-action="automation" data-op="useItem" data-item-id="{{id}}">{{ttbText 'Использовать 1'}}</button>{{/if}}{{/if}}
  <details class="ttb-record-description" data-fold="record-{{id}}"><summary>{{ttbText 'Описание и правила'}}</summary><p class="ttb-help">{{description}}</p></details></section>{{else}}<p>{{ttbText 'Пока нет отдельных записей. Добавьте их кнопками выше.'}}</p>{{/each}}{{/if}}
  {{#if developmentTab}}<h2>{{ttbText 'Развитие'}}</h2><label>{{ttbText 'Текущее Стремление'}}<select data-pursuit-select>{{selectOptions pursuitOptions selected=s.currentPursuitId}}</select></label><p class="ttb-help">{{ttbText 'Способность и доступные навыки берутся из текущего Стремления, даже если в эпилоге продвигается другое продвинутое Стремление. Создание по Таро выдаёт стартовый талант и талант шага 0.'}}</p><p>{{ttbText 'Доступно опыта:'}} <b>{{s.xp}}</b></p><div class="ttb-actions">{{#if isGM}}<button type="button" data-action="automation" data-op="epilogue">{{ttbText 'Открыть эпилог сессии'}}</button>{{/if}}<button type="button" data-action="automation" data-op="learnTrigger">{{ttbText 'Изучить триггер (1 опыт)'}}</button></div><p class="ttb-help">{{ttbText 'Мастер выбирает два навыка. Навыки способности продвигаемого Стремления добавляются из его записи. За сессию можно повысить один разрешённый навык; цена равна текущему рангу. Талант выбирается из проверенных вариантов шага. Требования и условные эффекты сверяйте по описанию.'}}</p>
  {{#each epilogues}}<section class="ttb-record"><b>{{id}}</b>{{#if rewardStep}}<p>{{ttbText 'Талант шага'}} {{rewardStep}}: {{#if rewardChosen}}{{rewardChosen}}{{else}}{{ttbText 'не выбран'}}{{/if}}</p>{{/if}}{{#if rewardAvailable}}<button type="button" data-action="automation" data-op="choosePursuitTalent" data-epilogue-id="{{id}}">{{ttbText 'Выбрать талант шага'}}</button>{{/if}}<p>{{ttbText 'Доступные навыки:'}} {{eligibleNames}}</p>{{#if chosen}}<p>{{ttbText 'Повышен:'}} {{chosenName}}</p>{{else}}{{#if closed}}<p>{{ttbText 'Эпилог закрыт без повышения'}}</p>{{else}}<button type="button" data-action="automation" data-op="advanceSkill" data-epilogue-id="{{id}}">{{ttbText 'Выбрать повышение'}}</button>{{/if}}{{/if}}</section>{{/each}}
  <h2>{{ttbText 'Шаги Стремлений'}}</h2>{{#each pursuitRows}}<p>{{name}}: {{step}} / {{maximum}}</p>{{/each}}
  <h2>{{ttbText 'Изученные триггеры'}}</h2>{{#each triggers}}<section class="ttb-record"><b>{{skillName}} · {{name}} · {{suits}}</b><p>{{description}}</p></section>{{else}}<p class="ttb-help">{{ttbText 'Ранее записанные триггеры сохранены во вкладке «Навыки» как текст. Они не перенесены автоматически, чтобы не назначить неверные масти.'}}</p>{{/each}}{{/if}}
  {{#if fateTab}}
    {{#unless isNPC}}
    <div class="ttb-section-head"><h2>{{ttbText 'Рука контроля'}}</h2><span>{{handCount}} {{ttbText '/ 5 карт'}}</span></div>
    {{#if overflow}}<p class="ttb-alert">{{ttbText 'Выберите лишние карты и сбросьте их до пяти. Затем можно продолжить проверки.'}}</p>{{/if}}
    {{#unless hasDeck}}<p class="ttb-help">{{ttbText 'Выберите четыре разные масти ниже. Затем мастер создаёт личную колоду кнопкой «Подготовить колоду». После создания состав зафиксирован.'}}</p>{{/unless}}
    <div class="ttb-hand">{{#each handCards}}<label class="ttb-hand-card"><img src="{{img}}" alt="{{name}}"><span><input type="checkbox" data-hand-card="{{id}}">{{name}}</span></label>{{else}}<p class="ttb-help">{{ttbText 'В руке пока нет карт. Мастер раздаёт три карты в конце пролога.'}}</p>{{/each}}</div>
    <div class="ttb-actions"><button type="button" data-action="hand" data-op="discard">{{ttbText 'Сбросить выбранные'}}</button>{{#if credits}}<button type="button" data-action="hand" data-op="credit">{{ttbText 'Взять за перетасовку ('}}{{credits}})</button><button type="button" data-action="hand" data-op="declineCredit">{{ttbText 'Отказаться от добора'}}</button>{{/if}}{{#if refresh}}<button type="button" data-action="hand" data-op="refresh">{{ttbText 'Обновить руку после сцены'}}</button>{{/if}}{{#if isGM}}{{#unless hasDeck}}<button type="button" data-action="hand" data-op="setupActor">{{ttbText 'Подготовить колоду'}}</button>{{/unless}}{{#if hasDeck}}<button type="button" data-action="hand" data-op="give">{{ttbText 'Выдать 1 карту'}}</button>{{/if}}{{/if}}</div>
    <p class="ttb-help">{{ttbText 'Чтобы Обмануть судьбу, нажмите соответствующую кнопку в сообщении проверки. Добор за талант подтверждает мастер кнопкой «Выдать 1 карту».'}}</p>
    <h2>{{ttbText 'Смешанная колода'}}</h2><div class="ttb-fields">{{#each twistRoles}}<label>{{label}}<select name="system.twist.{{index}}" {{#if @root.hasDeck}}disabled{{/if}}>{{selectOptions @root.suitOptions selected=suit}}</select></label>{{/each}}</div><p class="ttb-help">{{ttbText 'Определяющая: 1, 5, 9, 13 · Предков: 4, 8, 12 · Центральная: 3, 7, 11 · Наследия: 2, 6, 10.'}}</p>
    {{else}}<p class="ttb-help">{{ttbText 'У персонажей мастера нет личной руки и Обмана судьбы. Мастер управляет общей колодой через «Стол Судьбы».'}}</p>{{/unless}}
    {{#if openChecks}}<p class="ttb-alert">{{ttbText 'В чате есть незавершённая проверка. Выберите карту, при желании обманите судьбу и нажмите «Завершить».'}}</p>{{/if}}
    <h2>{{ttbText 'Предсказание судьбы'}}</h2><textarea name="system.fate" class="ttb-long" placeholder="{{ttbText 'Корень, тело, разум, станция и стремление; карты Таро и пророчество'}}">{{s.fate}}</textarea>
  {{/if}}
  {{#if storyTab}}<h2>{{ttbText 'Оружие и снаряжение'}}</h2><button type="button" data-action="createWeapon">{{ttbText 'Добавить оружие'}}</button>{{#each weapons}}<p><button type="button" data-action="attack" data-item-id="{{id}}">{{ttbText 'Атака:'}} {{name}}</button> · {{skill}} · {{range}} · {{damage}}</p>{{/each}}<textarea class="ttb-long" name="system.gear" placeholder="{{ttbText 'Название, навык, дальность, урон слабый/умеренный/тяжёлый, боезапас и свойства'}}">{{s.gear}}</textarea><h2>{{ttbText 'Таланты и способности Стремления'}}</h2><textarea class="ttb-long" name="system.talents">{{s.talents}}</textarea><div class="ttb-fields"><label>{{ttbText 'Магическая теория'}}<input name="system.magicTheory" value="{{s.magicTheory}}"></label><label>{{ttbText 'Гримуары, Магия и Иммуто'}}<textarea name="system.grimoire">{{s.grimoire}}</textarea></label></div><h2>{{ttbText 'Предметы Foundry'}}</h2>{{#each items}}<p><button type="button" data-action="item" data-item-id="{{id}}">{{name}}</button> × {{quantity}} · {{description}}</p>{{else}}<p class="ttb-help">{{ttbText 'Можно перетащить предметы из вкладки «Предметы» Foundry в этот лист.'}}</p>{{/each}}<h2>{{ttbText 'История и заметки'}}</h2><textarea class="ttb-long" name="system.notes">{{s.notes}}</textarea>{{/if}}
  </div><footer class="ttb-footer">{{ttbText 'Изменения сохраняются автоматически · Правила второго издания ·'}} {{systemVersion}}</footer>
</div>
